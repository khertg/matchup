# Cloud features (club login, live board, club leaderboard) need the Matchup API. When it is
# set, staff must log in to a club before using the app (the saved login works offline).
# Copy this file to .env.local. With this unset there is no login and the app runs entirely on the device.
#
# Where the API lives. `/api` works everywhere the app and API share an origin: the dev and
# preview servers proxy /api to the API (see API_PROXY_TARGET), and so does the production
# reverse proxy. A full URL such as https://example.com/api also works (then set ALLOWED_ORIGINS
# on the API).
VITE_API_URL=/api

# Dev and preview servers only: where /api is forwarded. Defaults to http://localhost:8787.
# API_PROXY_TARGET=http://localhost:8787
