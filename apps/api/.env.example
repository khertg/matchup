# Copy to .env for local development (`npm run dev -w @q2dink/api` reads it).
# Postgres in production; `pglite://./.data` (embedded, no Docker) is the dev default.
DATABASE_URL=postgres://q2dink:q2dink@localhost:5432/q2dink
PORT=8787
# Only for setups where the web app is on a different origin than the API. Comma separated.
ALLOWED_ORIGINS=
# Set to true behind a reverse proxy such as Caddy so rate limits see the real client IP.
TRUST_PROXY=false
LOG_LEVEL=info
